<!--
    Logo del PDV (vectorial, lienzo de 256x256).
    Ticket de compra blanco sobre fondo azul con una palomita verde: "venta lista".
    Lo usan las pantallas (login, menú, venta) y la herramienta que genera pdv.ico.
    La misma figura está en docs/logo/pdv-logo.svg.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Fondo: cuadro redondeado azul -->
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2F72BC" Offset="0"/>
                            <GradientStop Color="#1F4E79" Offset="1"/>
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Sombra del ticket -->
                <GeometryDrawing Brush="#33000000"
                                 Geometry="M76,58 Q76,46 88,46 L176,46 Q188,46 188,58 L188,210 L174,220 L160,210 L146,220 L132,210 L118,220 L104,210 L90,220 L76,210 Z"/>

                <!-- Ticket con orilla cortada en zigzag -->
                <GeometryDrawing Brush="White"
                                 Geometry="M70,52 Q70,40 82,40 L170,40 Q182,40 182,52 L182,204 L168,214 L154,204 L140,214 L126,204 L112,214 L98,204 L84,214 L70,204 Z"/>

                <!-- Renglones del ticket -->
                <GeometryDrawing Brush="#C5D3E4">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="88,62,76,12" RadiusX="6" RadiusY="6"/>
                            <RectangleGeometry Rect="88,86,54,12" RadiusX="6" RadiusY="6"/>
                            <RectangleGeometry Rect="88,110,66,12" RadiusX="6" RadiusY="6"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Total -->
                <GeometryDrawing Brush="#1F4E79">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="88,136,40,14" RadiusX="7" RadiusY="7"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- Palomita verde: venta cobrada -->
                <GeometryDrawing Brush="#1A9E46">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="10"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="180,182" RadiusX="42" RadiusY="42"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M160,183 L174,197 L200,168">
                    <GeometryDrawing.Pen>
                        <Pen Brush="White" Thickness="14" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
